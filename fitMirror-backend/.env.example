# ═══════════════════════════════════════════════════════════
# AI 电商商品图自动生成系统 · 配置文件
# ═══════════════════════════════════════════════════════════

# ── API 提供商 ────────────────────────────────────────────
API_PROVIDER=dashscope

# ── API 凭证 (必填) ──────────────────────────────────────
# 请替换为你的百炼 API Key
OPENAI_API_KEY=

# ── API 接入地址 ──────────────────────────────────────────
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_IMAGE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation

# ── 模型名称 ──────────────────────────────────────────────
VISION_MODEL=qwen-vl-max
TEXT_MODEL=qwen3.6-35b-a3b
#MODEL_NAME=qwen-vl-max
IMAGE_MODEL=qwen-image-2.0-pro-2026-04-22

# ── Web 服务 ──────────────────────────────────────────────
WEB_HOST=127.0.0.1
WEB_PORT=8000

# ── 输出 ──────────────────────────────────────────────────
OUTPUT_ROOT=output

# ── 性能 ──────────────────────────────────────────────────
REQUEST_TIMEOUT=600
CONCURRENCY=2
MAX_RETRIES=3
RETRY_BACKOFF=2.0

# ── 行为 (学习阶段建议 hero 模式, 只生成 5 张主图) ────────
GENERATION_MODE=hero
FORCE=false
USE_PROMPT_CACHE=true

# ── 日志 ──────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── 数据库 (MySQL) ────────────────────────────────────────
DB_TYPE=mysql
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=fitmirror

# AgentFlow migration: keep false until CatalogAgent has passed staging checks
AGENTFLOW_CATALOG_ENABLED=false
AGENTFLOW_POLICY_RAG_ENABLED=false

AGENTFLOW_TRYON_ENABLED=false
